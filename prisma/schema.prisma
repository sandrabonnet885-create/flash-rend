generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  clerkId       String          @unique
  email         String          @unique
  firstName     String?
  lastName      String?
  balance       Float           @default(0)
  bonusClaimed  Boolean         @default(false)
  welcomeEmailSent Boolean      @default(false)
  transactions  Transaction[]
  bankAccounts  BankAccount[]
  investments   Investment[]
  refundRequests RefundRequest[]
  bankTransferDeposits BankTransferDeposit[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Investment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  amount          Float
  multiplier      Float
  potentialReturn Float
  endsAt          DateTime
  status          InvestmentState  @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
}

enum InvestmentState {
  ACTIVE
  COMPLETED
  CLOSED
}

model RefundRequest {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  amount          Float
  reason          String
  description     String?
  status          RefundRequestStatus @default(PENDING)
  adminResponse   String?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
}

model BankTransferDeposit {
  id              String                    @id @default(cuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id])
  amount          Float
  reference       String                    // ID transaction fourni par l'utilisateur
  transferDate    DateTime                  // Date du virement
  status          BankTransferDepositStatus @default(PENDING)
  proofUrl        String?                   // URL de la preuve de virement
  adminNote       String?                   // Note de l'admin
  processedBy     String?                   // Email de l'admin qui a traité
  processedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
}

enum BankTransferDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model BankTransferSettings {
  id              String   @id @default(cuid())
  accountHolder   String
  iban            String
  bic             String
  bankName        String
  instructions    String?  // Instructions personnalisées
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Transaction {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Float
  currency        String        @default("EUR")
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  description     String?
  reference       String?       @unique
  metadata        Json?
  stripePaymentId String?
  bankTransferId  String?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id])
  bankAccountId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([userId])
  @@index([stripePaymentId])
  @@index([bankTransferId])
}
model BankAccount {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  accountHolder String
  iban          String
  bic           String?
  bankName      String?
  isDefault     Boolean       @default(false)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([userId, iban])
}
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  DIVIDEND
  REFUND
  FEE
  BONUS
}
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}
